# Environment Configuration for PQC Migration Analyzer (Qryptis)

# Secret key for Flask session security (generate a secure random 32-byte hex string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Port and Host
FLASK_RUN_PORT=5000
FLASK_RUN_HOST=0.0.0.0

# Optional: Custom Ollama endpoint (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
